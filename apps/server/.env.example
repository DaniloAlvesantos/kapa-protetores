PORT=4000
NODE_ENV=development
# Lista exata de origens web permitidas, separadas por vírgula.
CLIENT_URL=http://localhost:8081,http://localhost:8082
DOCKER_DATABASE_URL="postgresql://docker:docker@localhost:5432/kapa?schema=public"
DATABASE_URL=""
DIRECT_URL=""

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER=kapa-api
JWT_AUDIENCE=kapa-app
ACCESS_TOKEN_TTL_SECONDS=604800
# URL completa para ambientes hospedados. Use rediss:// quando o provedor oferecer TLS.
REDIS_URL=
# Fallback usado apenas no desenvolvimento local quando REDIS_URL estiver vazia.
REDIS_PORT=6379
REDIS_PASSWORD=kapa
# Provedor de armazenamento de fotos: "docker" (MinIO local) ou "supabase"
STORAGE_PROVIDER=docker

# Configurações para STORAGE_PROVIDER=docker (padrão local)
DOCKER_S3_ENDPOINT=http://localhost:9000
DOCKER_S3_PUBLIC_URL=http://localhost:9000
DOCKER_S3_REGION=us-east-1
DOCKER_S3_BUCKET=kapa-public
DOCKER_S3_ACCESS_KEY=kapa
DOCKER_S3_SECRET_KEY=kapa-local-storage-secret

# Configurações para STORAGE_PROVIDER=supabase
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=kapa-public
SUPABASE_S3_ACCESS_KEY=sua-access-key-supabase
SUPABASE_S3_SECRET_KEY=sua-secret-key-supabase

# Fallback genérico S3 (usado em produção/deploy no Render ou quando STORAGE_PROVIDER for "custom")
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kapa-public
S3_ACCESS_KEY=kapa
S3_SECRET_KEY=kapa-local-storage-secret

SALT_SECRET=
GOOGLE_API_ID=
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
